{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.upstash/context7",
  "title": "Context7",
  "description": "Up-to-date code docs for any prompt",
  "repository": {
    "url": "https://github.com/upstash/context7",
    "source": "github"
  },
  "websiteUrl": "https://context7.com",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/upstash/context7/master/public/icon.png",
      "mimeType": "image/png"
    }
  ],
  "version": "2.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@upstash/context7-mcp",
      "version": "2.0.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CONTEXT7_API_KEY",
          "description": "API key for authentication",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "MCP_REQUIRE_AUTH",
          "description": "Require authentication for /mcp (default true)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "MCP_BIND_ADDRESS",
          "description": "Bind address for HTTP transport (default 127.0.0.1)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "MCP_CORS_ALLOWED_ORIGINS",
          "description": "Comma-separated CORS allowlist (empty disables CORS)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "MCP_TRUST_PROXY",
          "description": "Trust upstream proxies for X-Forwarded-For",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "MCP_TRUSTED_PROXY_IPS",
          "description": "Comma-separated proxy IP allowlist for X-Forwarded-For",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "MCP_RATE_LIMIT_SWEEP_INTERVAL_MS",
          "description": "Rate limit eviction interval in milliseconds",
          "isRequired": false,
          "isSecret": false
        }
      ]
    },
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/upstash/context7/releases/download/@upstash/context7-mcp@2.0.2/context7.mcpb",
      "version": "2.0.2",
      "fileSha256": "aea76f179ceb92d22c289147c9d8343fb558d6dec93b144c9794e99239bb8194",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "CONTEXT7_API_KEY",
          "description": "API key for authentication",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "MCP_REQUIRE_AUTH",
          "description": "Require authentication for /mcp (default true)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "MCP_BIND_ADDRESS",
          "description": "Bind address for HTTP transport (default 127.0.0.1)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "MCP_CORS_ALLOWED_ORIGINS",
          "description": "Comma-separated CORS allowlist (empty disables CORS)",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "MCP_TRUST_PROXY",
          "description": "Trust upstream proxies for X-Forwarded-For",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "MCP_TRUSTED_PROXY_IPS",
          "description": "Comma-separated proxy IP allowlist for X-Forwarded-For",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "MCP_RATE_LIMIT_SWEEP_INTERVAL_MS",
          "description": "Rate limit eviction interval in milliseconds",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.context7.com/mcp",
      "headers": [
        {
          "name": "CONTEXT7_API_KEY",
          "description": "API key for authentication",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
